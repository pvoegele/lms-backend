# Cloud SQL Configuration (for production)
QW_USE_CLOUD_SQL_CONNECTOR=false
QW_CLOUD_SQL_CONNECTION_NAME=project-id:region:instance-name
QW_PSQL_PUBLIC_IP=0.0.0.0

# Standard PostgreSQL (for local development)
QW_PSQL_NODE_HOSTNAME=localhost
QW_PSQL_NODE_TCP_PORT=5432
QW_PSQL_SCHEMA_VAULT=nexus_warehouse
QW_PSQL_AUTH_PRINCIPAL=nexus_user
QW_PSQL_AUTH_TOKEN=changeme123

# API Configuration
QW_GATEWAY_MOUNT_POINT=/api/v1
QW_NEXUS_DESIGNATION=WarehouseNexus
QW_DIAGNOSTIC_VERBOSITY=True
